<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only: allow http://10.0.2.2:50051 style emulator endpoints and
     user-installed CAs (mkcert) for local HTTPS edges. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
