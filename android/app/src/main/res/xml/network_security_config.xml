<?xml version="1.0" encoding="utf-8"?>
<!-- Release: HTTPS only, system CAs only. Self-signed and user CAs are rejected. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
