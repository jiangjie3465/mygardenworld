# Copy to keystore.properties (gitignored) and point at your release keystore.
# Generate one with:
#   keytool -genkeypair -keystore keystore/release.jks -alias mygardenworld -keyalg RSA -keysize 4096 -validity 10000
storeFile=keystore/release.jks
storePassword=
keyAlias=mygardenworld
keyPassword=
