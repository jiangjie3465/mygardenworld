# mygardenworld gardend behind the HTTPS edge. gardend listens on 127.0.0.1:50051.
server {
    listen 80;
    listen [::]:80;
    server_name garden.example.com;

    return 301 https://garden.example.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name garden.example.com;

    ssl_certificate /etc/ssl/garden.example.com.pem;
    ssl_certificate_key /etc/ssl/garden.example.com.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    client_max_body_size 10M;

    access_log /var/log/nginx/mygardenworld.access.log;
    error_log /var/log/nginx/mygardenworld.error.log notice;

    # Workspace WebSocket: long-lived, needs Upgrade and generous read timeout.
    location /api/workspace {
        proxy_pass http://127.0.0.1:50051;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # Connect RPC and the embedded Web UI. Account creation performs the game
    # login inline, so allow a long upstream read.
    location / {
        proxy_pass http://127.0.0.1:50051;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
